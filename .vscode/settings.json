{
    "dotnet.defaultSolution": "Reactivities.sln",
    "csharp-dev-tools.solutionViewer.selectedWorkspaceSolutions": [
        "Reactivities.sln"
    ],
    // CodeLens: يظهر عدد المراجع (References) وتجارب الاختبار فوق الكلاسات والدوال مثل Visual Studio
    "editor.codeLens": true,
    "csharp.referencesCodeLens.enabled": true,
    "csharp.testsCodeLens.enabled": true,
    "dotnet.codeLens.enableReferencesCodeLens": true,

    // Inlay Hints: يظهر أسماء المتغيرات والأنواع تلقائياً بجانب الكود
    "editor.inlayHints.enabled": "on",
    "csharp.inlayHints.enableInlayHintsForParameters": true,
    "csharp.inlayHints.enableInlayHintsForLiteralParameters": true,
    "csharp.inlayHints.enableInlayHintsForObjectCreationParameters": true,
    "csharp.inlayHints.enableInlayHintsForIndexerParameters": true,
    "csharp.inlayHints.enableInlayHintsForTypes": true,

    // خطوط الإرشاد والمحاذاة والأقواس مثل Visual Studio
    "editor.guides.indentation": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": true,
    "editor.guides.highlightActiveBracketPair": true,
    "editor.guides.highlightActiveIndentation": true,

    // الاقتراحات وإظهار الأخطاء والتحذيرات والخطوط المتعرجة (Squiggly lines) فوراً
    "editor.quickSuggestions": {
        "other": true,
        "comments": true,
        "strings": true
    },
    "editor.suggestOnTriggerCharacters": true,
    "editor.hover.enabled": "on",
    // استخدام خادم Roslyn الحديث للـ .NET بدلاً من OmniSharp القديم لدعم .NET 10/.NET 11
    "dotnet.server.useOmnisharp": false,

    // التنسيق التلقائي للكود
    "editor.formatOnSave": true,
    "editor.formatOnType": true,

    // إخفاء مجلدات البناء المؤقتة من مستعرض الملفات فقط دون حجبها عن خادم اللغة و Intellisense
    "explorer.exclude": {
        "**/bin": true,
        "**/obj": true
    }
}